{
  "name": "shift-ax",
  "version": "0.5.6",
  "description": "Agentic software delivery platform for teams that are not AX experts yet",
  "type": "module",
  "private": false,
  "homepage": "https://github.com/handsupmin/shift-ax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handsupmin/shift-ax.git"
  },
  "bugs": {
    "url": "https://github.com/handsupmin/shift-ax/issues"
  },
  "files": [
    "dist",
    "!dist/tests",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "bin": {
    "shift-ax": "dist/scripts/ax.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-package-assets.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "shift-ax": "node --import tsx scripts/ax.ts",
    "prepack": "npm run build",
    "eval": "node --import tsx tests/eval/index.ts",
    "eval:objective": "node --import tsx scripts/ax-eval.ts",
    "eval:edge-cases": "node --import tsx tests/eval/edge-cases.ts",
    "eval:real-world": "node --import tsx tests/eval/real-world.ts",
    "eval:performance": "node --import tsx tests/eval/performance.ts",
    "eval:all": "npm run eval && npm run eval:edge-cases && npm run eval:real-world && npm run eval:performance && npm run eval:objective"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
